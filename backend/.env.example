# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas
# Get from: https://cloud.mongodb.com → Connect → Drivers
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/delivrd?retryWrites=true&w=majority

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRES_IN=7d

# Supabase (for file storage / future auth)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Cloudinary (product image uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL (for CORS) - IMPORTANT FOR PRODUCTION
# Set this to your deployed frontend URL (e.g., https://beetle-frontend.vercel.app)
# Without this, registration requests from the frontend will be blocked by CORS
CLIENT_URL=http://localhost:3000
CLIENT_URL_SECONDARY=

# Production: Set NODE_ENV=production when deploying to enable:
# - Trust proxy headers
# - Additional security headers
# - Optimized logging
